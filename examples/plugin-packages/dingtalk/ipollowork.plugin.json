{
  "schemaVersion": 2,
  "id": "dingtalk",
  "name": "钉钉",
  "description": "钉钉 MCP：通讯录、部门、机器人消息/DING、待办、日程、工作通知、日志等能力。扫码登录即可用，无需创建应用。",
  "category": "办公协作",
  "source": {
    "format": "ipollowork-extension-manifest",
    "origin": "builtin",
    "trusted": true,
    "reference": "https://github.com/open-dingtalk/dingtalk-mcp"
  },
  "icon": {
    "simpleIconSlug": "dingtalk"
  },
  "composer": {
    "prompt": "使用钉钉插件查询或处理待办、日程、消息和审批相关事项，涉及写操作前先确认范围。"
  },
  "setup": {
    "instructions": "无需创建应用：首次使用先安装 dws CLI（curl -fsSL https://raw.githubusercontent.com/DingTalk-Real-AI/dingtalk-workspace-cli/main/scripts/install.sh | sh），然后在终端运行 dws auth login，用钉钉 App 扫码授权一次即可，后续自动续期。",
    "primaryCta": "查看 dws 安装与登录指南",
    "secondaryCta": "查看 dingtalk-mcp 文档"
  },
  "localization": {
    "defaultLocale": "zh",
    "translations": {
      "en": {
        "description": "DingTalk MCP: contacts, departments, robot messages/DING, todos, calendar, work notices, and reports. Scan-to-login, no app creation required.",
        "category": "Work Collaboration",
        "composer": {
          "prompt": "Use the DingTalk plugin to query or handle todos, calendar, messages, and approvals; confirm scope before write actions."
        },
        "setup": {
          "instructions": "No app creation needed: install the dws CLI once (curl -fsSL https://raw.githubusercontent.com/DingTalk-Real-AI/dingtalk-workspace-cli/main/scripts/install.sh | sh), then run `dws auth login` in a terminal and scan the QR code with the DingTalk mobile app. Tokens renew automatically afterwards.",
          "primaryCta": "View dws install & login guide",
          "secondaryCta": "View dingtalk-mcp docs"
        },
        "resources": {
          "dingtalk-mcp": {
            "label": "DingTalk MCP",
